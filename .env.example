# Discord — pegue no Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional (dev): id do servidor p/ registrar comandos instantaneamente
DISCORD_GUILD_ID=

# Gemini — pegue no Google AI Studio
GEMINI_API_KEY=
# Opcional: modelo (padrão gemini-3.6-flash)
GEMINI_MODEL=

# PostgreSQL — Railway injeta DATABASE_URL no deploy
DATABASE_URL=postgresql://user:password@localhost:5432/menstrual_bot
